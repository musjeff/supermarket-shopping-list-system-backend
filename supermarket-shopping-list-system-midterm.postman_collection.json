  "item": [
    {
      "name": "A1 - Domain model tables",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/departments/all"
      },
      "response": []
    },
    {
      "name": "A2 - CRUD endpoints",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/shoppers/all"
      },
      "response": []
    },
    {
      "name": "B1 - Shoppers by last name",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/shoppers/by-last-name?lastName=musana"
      },
      "response": []
